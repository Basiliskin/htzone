{
    "name": "htzone/catalog-search",
    "description": "Smart Hebrew/English catalog search (home assignment).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.3.0",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "Htzone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Htzone\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.37"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "check": ["@cs", "@stan", "@test"]
    }
}
