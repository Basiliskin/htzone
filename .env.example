# Copy to .env only if you need to override defaults. There are no secrets in this app.
APP_ENV=dev          # prod | dev | test
DB_PATH=/app/var/catalog.sqlite
LOG_LEVEL=info       # debug | info | warning | error
XDEBUG_MODE=off      # dev image only: set to "debug" for step debugging
PORT=8080            # Apache listen port; Render sets 10000 itself
